# =============================================================================
# E-Commerce Cloud Infrastructure - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Application Configuration ---
APP_PORT=8080
NODE_ENV=production

# --- Database Configuration (Local Development) ---
DB_USER=ecommerce_user
DB_PASSWORD=your_secure_password_here
DB_NAME=ecommerce_db
DB_PORT=5432

# --- Database Configuration (AWS RDS) ---
# Used when deploying to AWS. The writer host points to the primary RDS instance,
# and the reader host points to the read replica.
DB_WRITER_HOST=your-rds-primary-endpoint.region.rds.amazonaws.com
DB_READER_HOST=your-rds-replica-endpoint.region.rds.amazonaws.com

# --- AWS Configuration ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# --- Datadog Configuration ---
DD_API_KEY=your_datadog_api_key
DD_SITE=datadoghq.com
DD_SERVICE=ecommerce-api
DD_ENV=development
DD_LOGS_INJECTION=true
DD_PROFILING_ENABLED=true

# --- Terraform Variables ---
TF_VAR_db_username=ecommerce_user
TF_VAR_db_password=your_secure_password_here
