# =============================================================================
# E-Commerce Cloud Infrastructure - .gitignore
# =============================================================================

# --- Environment & Secrets ---
.env
.env.local
.env.*.local

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Terraform ---
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars
!*.tfvars.example

# --- IDE & Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- OS Files ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Logs ---
logs/
*.log

# --- Docker ---
docker-volumes/

# --- Build Output ---
dist/
build/
coverage/

# --- Miscellaneous ---
*.bak
*.tmp
*.temp
